# Copy this file to .env.local to fill these in. All are optional.

# Where "Try Ayin" goes: the running Ayin app.
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# The demo video. A YouTube or Vimeo embed URL, or a link to an .mp4.
# Until it's set, the demo section shows a "coming soon" card.
# NEXT_PUBLIC_DEMO_VIDEO_URL=

# An email address for "Get in touch". Leave empty to hide that link.
# NEXT_PUBLIC_CONTACT_EMAIL=
