# Copy this file to .env.local and fill in your own values. Never commit .env.local.

# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# The Postgres database. On Supabase: the transaction pooler connection string (port 6543),
# from the project's Connect settings.
DATABASE_URL=

# Optional: Ayin's voice. Cartesia first (https://cartesia.ai), Deepgram Aura as the backup
# (https://deepgram.com). Without either, the browser's own voice speaks.
# CARTESIA_API_KEY=
# AYIN_VOICE_ID=ca566b43-944e-4474-b494-7d9f0695f307
# DEEPGRAM_API_KEY=
# AYIN_BACKUP_VOICE=aura-2-helena-en

# Optional: the Claude model to use (defaults to claude-opus-5-5)
# AYIN_MODEL=claude-opus-5-5

# Optional: the otter's camera (XIAO or Raspberry Pi). The server takes photos from
# <this address>/capture when the browser doesn't send one.
# AYIN_CAMERA_URL=http://192.168.1.50

# Optional: a shared secret the otter sends with button presses.
# AYIN_DEVICE_TOKEN=

# Optional, for the landing page at /landing:
# the demo video (a YouTube or Vimeo embed URL, or an .mp4). Until it's set, a "coming soon" card shows.
# NEXT_PUBLIC_DEMO_VIDEO_URL=
# An email address for "Get in touch". Leave empty to hide it.
# NEXT_PUBLIC_CONTACT_EMAIL=
